PORT=5000

# MongoDB — local:      mongodb://127.0.0.1:27017/ayush_garden
#           Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ayush_garden?retryWrites=true&w=majority
# Leave empty to run on the local JSON store (server/data/store.json).
MONGODB_URI=mongodb://127.0.0.1:27017/ayush_garden

# true = refuse to start if MongoDB is unreachable (recommended in production)
REQUIRE_MONGO=false
MONGO_TIMEOUT_MS=5000

JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=development
